# Set your own key before running live agents, simulators, or LLM judges.
OPENROUTER_API_KEY=

# Local development defaults. Bind the server to 127.0.0.1.
QTB_AUTH_MODE=disabled

# Optional authenticated deployments: set distinct, randomly generated values.
# QTB_REQUIRE_CLIENT_AUTH=true
# QTB_CLIENT_API_KEYS=replace-with-a-random-client-key=local-user|local-user||user
# QTB_ADMIN_TOKEN=replace-with-a-different-random-admin-token

# Optional native Anthropic mode; configure bench/client/adapters/config.py first.
# ANTHROPIC_API_KEY=
